# Environment variables read by the engine (server-py/). There is no .env loading: the engine
# reads these from the shell environment. Keep keys in your OS keychain or secrets manager and
# export them before starting the engine. Never put them in the web app.

# Claude through the Anthropic API: interprets free-form requests and questions (optional)
ANTHROPIC_API_KEY=
# Workspace id, needed only when the key is not scoped to a workspace
ANTHROPIC_WORKSPACE_ID=
# Model id, default claude-opus-5-5
ANTHROPIC_MODEL=
# TypeSafe Jev for fast command routing (optional)
TYPESAFE_API_KEY=
# Folder for the map (osmnx) and transit caches
TOOLS=
# Set to porta-romana to load the small Porta Romana test zone instead of central Milan
LOTL_ZONE=
# Set to 1 to never call the transit API (Transitous): answers come from the cache only
LOTL_OFFLINE=
# Map data date written into every answer, default 2026-09-26
LOTL_SNAPSHOT=
