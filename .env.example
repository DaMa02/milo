# Copy to .env (gitignored) and fill in. Keys are read by server/ only, never by the browser.

# LLM and vision, OpenAI-compatible
OPENROUTER_API_KEY=
# Direct Anthropic API, only for Anthropic-specific tools (e.g. computer use)
ANTHROPIC_API_KEY=
# Realtime speech-to-text
DEEPGRAM_API_KEY=
# Fast typed judgments (TypeSafe Jev). Without a TypeSafe account, Jev is also reachable
# through OpenRouter (/api/v1/systemone, beta) with OPENROUTER_API_KEY.
TYPESAFE_API_KEY=
# Realtime multimodal (camera, audio)
GEMINI_API_KEY=
# Voice-over for the demo video
ELEVENLABS_API_KEY=
