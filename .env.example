# Copy to .env (gitignored) and fill in. Keys are read by server/ only, never by the browser.

# LLM and vision, OpenAI-compatible
OPENROUTER_API_KEY=
# Claude through the Anthropic API: the product LLM (server-py only)
ANTHROPIC_API_KEY=
# Required by the event key, which is not scoped to a workspace (format wrkspc_...)
ANTHROPIC_WORKSPACE_ID=
# Optional, default claude-opus-5
ANTHROPIC_MODEL=
# Realtime speech-to-text
DEEPGRAM_API_KEY=
# Fast typed judgments (TypeSafe Jev). Without a TypeSafe account, Jev is also reachable
# through OpenRouter (/api/v1/systemone, beta) with OPENROUTER_API_KEY.
TYPESAFE_API_KEY=
# Realtime multimodal (camera, audio)
GEMINI_API_KEY=
# Voice-over for the demo video
ELEVENLABS_API_KEY=
# Web information about a place or street (level 3), called from the server only
TAVILY_API_KEY=
